# Since each "action" responds to a single condition, best to divide these into discrete On: Do: files.

# Menu name of the action
name: GitHub Actions Demo

# What's displayed in the output log for this job.
run-name: ${{ github.actor }} is testing out GitHub Actions 🚀

# When to trigger this see https://docs.github.com/en/actions/reference/workflows-and-actions/events-that-trigger-workflows
on:
  push:
    # Push takes a conditional (not everything does) No condition means On all matching actions.
    branches:
      - 'main'
      - 'demo'

# All the things that need to be done
jobs:
  Explore-GitHub-Actions:
    runs-on: ubuntu-latest
    steps:
      - run: echo "🎉 The job was automatically triggered by a ${{ github.event_name }} event on ${{ github.ref_name }}."
      - run: echo "🐧 This job is now running on a ${{ runner.os }} server hosted by GitHub!"
      - run: echo "🔎 The name of your branch is ${{ github.ref }} and your repository is ${{ github.repository }}."
      - name: Check out repository code
        uses: actions/checkout@v6
      - run: echo "💡 The ${{ github.repository }} repository has been cloned to the runner."
      - run: echo "🖥️ The workflow is now ready to test your code on the runner."
      - name: List files in the repository
        run: |
          ls ${{ github.workspace }}
      - run: echo "🍏 This job's status is ${{ job }}."
